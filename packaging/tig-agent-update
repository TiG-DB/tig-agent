#!/bin/bash
# Installs the latest tig-agent release from GitHub, and rolls back if it fails its health check.
# Run by tig-agent-update.timer. The release repository is public; an optional GITHUB_TOKEN from
# /etc/tig-agent/update.env raises the API rate limit, and is ignored if GitHub refuses it.
set -euo pipefail

repo=${TIG_AGENT_RELEASE_REPO:-TiG-DB/tig-agent}
signers=/usr/share/tig-agent/release-signers
cache=/var/cache/tig-agent
state=/var/lib/tig-agent-update
api=https://api.github.com/repos/$repo
health_delay=${TIG_AGENT_HEALTH_DELAY:-30}

use_token=1

log() {
  echo "$*" >&2
}

# GitHub's explanation of a failed request, from the body it saved
reason() {
  { jq -r '.message // empty' "$1" 2>/dev/null | head -c 200; } || true
}

# github <url> <file> [curl option...]: saves the response body to <file>. The release repository is public, so a
# GITHUB_TOKEN that GitHub refuses (expired, revoked, or barred by an organisation's token policy) is dropped for the rest
# of the run instead of stopping updates. Any other failure says what GitHub answered, which curl --fail would hide.
github() {
  local url=$1 out=$2 status
  shift 2
  while :; do
    local auth=()
    if [ "$use_token" = 1 ] && [ -n "${GITHUB_TOKEN:-}" ]; then
      auth=(-H "Authorization: Bearer $GITHUB_TOKEN")
    fi
    status=$(curl --silent --show-error --location --max-time 120 --output "$out" --write-out '%{http_code}' \
      ${auth[@]+"${auth[@]}"} -H "X-GitHub-Api-Version: 2022-11-28" "$@" "$url")
    case $status in
      2??) return 0 ;;
      401 | 403)
        if [ ${#auth[@]} -gt 0 ]; then
          log "GitHub refused GITHUB_TOKEN ($status: $(reason "$out")), so trying without it"
          use_token=0
          continue
        fi
        ;;
    esac
    log "GitHub answered $status for $url: $(reason "$out")"
    return 1
  done
}

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# a release's title is the package version, e.g. 0.1.0+42.1a2b3c4
github "$api/releases/latest" "$work/release.json"
release=$(<"$work/release.json")
version=$(jq -r '.name' <<<"$release")
current=$(dpkg-query -W -f='${Version}' tig-agent 2>/dev/null || echo 0)
arch=$(dpkg --print-architecture)

if ! dpkg --compare-versions "$version" gt "$current"; then
  exit 0
fi
if grep -qxF "$version" "$state/bad-versions" 2>/dev/null; then
  exit 0
fi

download() {
  local id
  id=$(jq -r --arg name "$1" '.assets[] | select(.name == $name) | .id' <<<"$release")
  if [ -z "$id" ]; then
    log "release $version has no $1"
    exit 1
  fi
  github "$api/releases/assets/$id" "$work/$1" -H "Accept: application/octet-stream"
}

deb=tig-agent_${version}_${arch}.deb
download SHA256SUMS
download SHA256SUMS.sig
download "$deb"

# SHA256SUMS is signed in CI with the release key; the public key ships in the package that is already installed
ssh-keygen -Y verify -f "$signers" -I tig-agent-release -n tig-agent-release \
  -s "$work/SHA256SUMS.sig" <"$work/SHA256SUMS" >/dev/null
sums=$(awk -v name="$deb" '$2 == name' "$work/SHA256SUMS")
if [ -z "$sums" ]; then
  log "SHA256SUMS does not list $deb"
  exit 1
fi
(cd "$work" && sha256sum --check --strict --quiet <<<"$sums")

# there is nobody to answer dpkg's question when a conffile the owner edited has a new version, so keep the owner's
dpkg_install() {
  DEBIAN_FRONTEND=noninteractive dpkg --force-confdef --force-confold -i "$1"
}

healthy() {
  sleep "$health_delay"
  systemctl is-active --quiet tig-agentd.service && runuser -u tig -- tig-agent status >/dev/null
}

log "updating tig-agent $current -> $version"
previous=$(ls "$cache"/tig-agent_*.deb 2>/dev/null | head -n 1 || true)

if dpkg_install "$work/$deb" && healthy; then
  rm -f "$cache"/tig-agent_*.deb
  cp "$work/$deb" "$cache/"
  log "tig-agent $version installed"
  exit 0
fi

log "tig-agent $version failed its health check, and won't be tried again"
echo "$version" >>"$state/bad-versions"
journalctl -u tig-agentd.service -n 20 --no-pager >&2 || true

if [ -n "$previous" ]; then
  log "rolling back to $(basename "$previous")"
  dpkg_install "$previous"
else
  log "no earlier package is cached, so there is nothing to roll back to"
fi
exit 1
